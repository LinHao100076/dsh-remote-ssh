{
  "name": "dsh-remote-ssh",
  "version": "0.7.0",
  "description": "Remote SSH for DSH: browse remote files, open remote terminals, and mirror local agent edits to a remote server with per-mapping sync direction.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "sftp",
    "remote-development",
    "remote",
    "terminal",
    "file-sync",
    "port-forward",
    "socks5",
    "tunnel"
  ],
  "homepage": "https://github.com/LinHao100076/dsh-remote-ssh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinHao100076/dsh-remote-ssh.git"
  },
  "bugs": {
    "url": "https://github.com/LinHao100076/dsh-remote-ssh/issues"
  },
  "author": "LinHao100076",
  "type": "module",
  "main": "lib/server.mjs",
  "exports": {
    ".": "./lib/server.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/server.mjs",
    "lib/client.js",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node --check src/index.js && node --check lib/client.js",
    "prepack": "node build.mjs",
    "pack:rel": "npm pack --pack-destination dist",
    "pretest": "node build.mjs",
    "test": "node test/smoke.mjs && node test/api.mjs && node test/ssh.mjs && node test/ssh.mjs --bundle && node test/auth.mjs && node test/jump.mjs && node test/files.mjs && node test/transfer.mjs && node test/safety.mjs && node test/sync.mjs && node test/forward.mjs && node test/socks5.mjs && node test/render.mjs && node test/native.mjs && node test/styles.mjs && node test/ws.mjs && node test/search.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:ssh": "node test/ssh.mjs && node test/ssh.mjs --bundle",
    "test:files": "node test/files.mjs",
    "test:transfer": "node test/transfer.mjs",
    "test:forward": "node test/forward.mjs",
    "test:render": "node test/render.mjs",
    "test:live": "node scripts/check-ssh.mjs",
    "test:e2e": "node test/e2e-profile.mjs",
    "test:native": "node test/native.mjs",
    "test:search": "node test/search.mjs",
    "test:socks5": "node test/socks5.mjs",
    "test:auth": "node test/auth.mjs",
    "test:jump": "node test/jump.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "dsh-better-sidebar": "*"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^4.0.3",
    "esbuild": "^0.25.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ssh2": "^1.17.0",
    "ws": "^8.18.3"
  }
}
